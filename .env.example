# Copy to .env (git-ignored) or point systemd's EnvironmentFile= at it.

# --- redaction ---------------------------------------------------------
# The pseudonymisation salt. If unset, watchdesk generates one at
# ~/.config/watchdesk/redact.salt on first run (mode 0600) and reuses it.
# Rotating it breaks correlation with every previously published report.
# It is a secret: whoever holds it can invert every ip: token watchdesk
# has ever emitted. Never commit it.
#WATCHDESK_REDACT_SALT=
#WATCHDESK_SALT_FILE=/etc/watchdesk/redact.salt

# What counts as "ours" — these are masked rather than pseudonymised, so
# they read as "the operator" in a report instead of as another anonymous
# third party. Comma-separated.
WATCHDESK_OWN_DOMAINS=example.com,mail.example.com
WATCHDESK_OWN_MAILBOXES=operator,postmaster
WATCHDESK_OWN_HOSTNAMES=mail.example.com

# --- LLM (OpenAI-compatible; stage 3) ----------------------------------
LLM_BASE_URL=https://cli.example.com/v1/chat/completions
LLM_MODEL=
LLM_API_KEY=

# --- sinks (stage 4) ---------------------------------------------------
#DISCORD_WEBHOOK_URL=
